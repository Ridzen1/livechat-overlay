{
  "name": "livechat-overlay",
  "version": "1.0.0",
  "description": "Overlay de chat pour afficher du texte, des images et des vidéos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "test": "node --test",
    "test:electron": "electron scripts/electron-smoke.cjs",
    "test:settings": "electron scripts/settings-smoke.cjs",
    "test:twitter": "electron scripts/twitter-smoke.cjs"
  },
  "build": {
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "cache-maintenance.js",
      "startup.js",
      "preload.js",
      "settings.html",
      "settings.js",
      "close.html",
      "close.js",
      "index.html",
      "renderer.js",
      "media-utils.js",
      "media-network.js",
      "overlay-server.js",
      "icon.png",
      "package.json"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^24.13.3"
  }
}
